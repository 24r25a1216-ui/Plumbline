# ── Plumbline configuration ──────────────────────────────
PORT=4000
# Generate a long random string for production
JWT_SECRET=change-me-to-a-long-random-string

# ── OpenAI (optional) ────────────────────────────────────
# Leave empty to run fully on the built-in local NLP engine.
# You can also paste the key later in Admin → Settings (stored in the DB).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Email notifications (Resend HTTPS API) ─────────────────
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Use onboarding@resend.dev only for initial testing to your verified address.
# For real citizen delivery, verify your own domain in Resend and use its sender.
EMAIL_FROM=onboarding@resend.dev
