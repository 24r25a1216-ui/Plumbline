{
  "name": "plumbline",
  "private": true,
  "version": "1.0.0",
  "description": "Plumbline — Multi-Domain Grievance Intelligence System",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c \"#C3CF7E,#86B5A0\" \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "reset": "npm run reset -w server",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
